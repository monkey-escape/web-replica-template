# 复制为 .env 后再改。这里只有占位符，没有任何可用的账号或密钥。
# 本模板的 API 不会连接 Postgres 或 Redis，也不会读取下面两个 URL。
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE_NAME
REDIS_URL=redis://127.0.0.1:6379/0

# 本地进程端口与前端来源。可以改，但不要写线上地址或 token。
PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173

# 本地 /media 默认读取仓库里的 fixtures/sites。需要改根目录时才设置，不要写密钥。
# MEDIA_ASSETS_ROOT=
